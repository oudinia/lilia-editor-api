<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engines shared by every host: LaTeX rendering, compilation, preamble
    construction and bibliography lookup. These used to live inside Lilia.Api,
    which meant the standalone tools could only run inside the editor's process.
    They depend on nothing above Core/Infrastructure, so they extract cleanly.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Lilia.Core\Lilia.Core.csproj" />
    <ProjectReference Include="..\Lilia.Infrastructure\Lilia.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Helpers the suite asserts on directly (FormatTitleMetaLatex and friends)
         stay internal rather than becoming public API for a test's sake. -->
    <InternalsVisibleTo Include="Lilia.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
