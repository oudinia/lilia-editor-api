@inherits LayoutComponentBase

<div class="shell">
    <nav class="side" data-testid="admin-nav">
        <div class="brand">Lilia <span>// admin</span></div>
        @* One column on a computer; on a phone, a 3 × 2 grid. *@
        <div class="nav-links">
            <NavLink href="" Match="NavLinkMatch.All" data-testid="admin-nav-overview">Overview</NavLink>
            <NavLink href="stats" data-testid="admin-nav-stats">Stats</NavLink>
            <NavLink href="users" data-testid="admin-nav-users">Users</NavLink>
            <NavLink href="errors" data-testid="admin-nav-errors">Errors</NavLink>
            <NavLink href="feedback" data-testid="admin-nav-feedback">Feedback</NavLink>
            <NavLink href="actions" data-testid="admin-nav-actions">Actions</NavLink>
        </div>
        <div class="side-foot">
            <a href="https://reports.liliaeditor.com/production-status.md" target="_blank" rel="noopener" data-testid="admin-link-status">Production status</a>
            <a href="https://errors.liliaeditor.com" target="_blank" rel="noopener" data-testid="admin-link-bugsink">Bugsink</a>
            <AuthorizeView><Authorized><span class="who" data-testid="admin-who">@context.User.FindFirst("email")?.Value</span></Authorized></AuthorizeView>
        </div>
    </nav>
    <main class="main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
