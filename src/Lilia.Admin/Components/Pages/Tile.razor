<a class="tile @(Warn ? "warn" : "")" href="@Href" data-testid="admin-tile" data-tile="@Id">
    <span class="label">@Label</span>
    <span class="value">@Fmt.Number(Value)</span>
    @if (Note is not null) { <span class="note">@Note</span> }
</a>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public long Value { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public bool Warn { get; set; }
    [Parameter] public string? Href { get; set; }
}
