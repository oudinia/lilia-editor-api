@page "/actions"
@inject AdminActions Actions

<PageTitle>Actions · Lilia admin</PageTitle>
<h1>Actions</h1>
<p class="lede">Everything done from this console, newest first: who, what, to which account, and why. Kept in admin_actions with each change.</p>
@if (rows is null) { <p class="muted">Loading…</p> }
else if (rows.Count == 0) { <p class="muted" data-testid="admin-actions-empty">Nothing done from the console yet.</p> }
else
{
    <table data-testid="admin-actions">
        <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Account</th><th>Why</th><th>Details</th></tr></thead>
        <tbody>
            @foreach (var a in rows)
            {
                <tr><td>@Fmt.When(a.At)</td><td>@a.AdminEmail</td><td><span class="chip">@a.Action</span></td>
                    <td>@if (a.TargetUserId is { } t) { <a href="users/@Uri.EscapeDataString(t)">@t[..Math.Min(12, t.Length)]…</a> }</td>
                    <td>@a.Reason</td><td><code>@a.Details</code></td></tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ActionRow>? rows;
    protected override async Task OnInitializedAsync() => rows = await Actions.HistoryAsync(null, 200);
}
